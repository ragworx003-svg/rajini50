# Public browser values. Safe to expose only with the provided RLS policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Vercel Function values. Never use a VITE_ prefix for these.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
ADMIN_PIN=                 # Use at least 8 characters; do not commit the real value.
ADMIN_SESSION_SECRET=      # Use a random secret with at least 32 characters.

# Razorpay server-side credentials. Key ID is returned by a server endpoint for Checkout.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
